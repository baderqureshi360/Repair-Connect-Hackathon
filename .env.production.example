# =============================================================================
# RepairConnect API — PRODUCTION template
# Copy to the host secret store / process manager env. NEVER commit real values.
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Atlas (required). Prefer least-privilege DB user + IP allowlist.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
USE_MEMORY_DB=false

# Auth (≥32 chars). Rotate if ever exposed in demo/logs.
JWT_SECRET=replace-with-openssl-rand-hex-32-or-longer
ACCESS_TOKEN_TTL_SEC=7200
REFRESH_TOKEN_TTL_SEC=604800

# Exact browser origin for CORS + credentialed cookies.
# Same-origin Enzonic deploy: set to the public HTTPS origin of THIS process.
CLIENT_URL=https://app.example.com
# CLIENT_URL_ALT=https://www.example.com

# Cookies — HTTPS production (same-origin: Lax; split hosts: none)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Dual Vercel projects (frontend *.vercel.app + API *.vercel.app) MUST use:
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.example.com

# Single-process web UI (adapter-node / Enzonic). Not used on Vercel API project.
# SERVE_WEB=true
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Vercel Cron drain for transactional outbox (Bearer token). Required on Vercel API project.
# CRON_SECRET=replace-with-long-random-string

# Forbidden in production (fatal if true):
SEED_ON_START=false
ALLOW_DEMO_LOGIN=false

# Optional provisioning / platform bootstrap (min 16 chars when set)
# PROVISIONING_API_KEY=

# Error monitoring (Sentry) — server-side DSN
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
