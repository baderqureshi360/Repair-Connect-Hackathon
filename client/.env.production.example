# =============================================================================
# RepairConnect frontend — PRODUCTION build-time template
# Set on the CI/CD build or host. NEVER put JWT_SECRET / MONGODB_URI here.
# =============================================================================

# Absolute API origin when frontend and API are on different hosts.
# Leave EMPTY / unset for Enzonic single-process same-origin (Express mounts adapter-node).
# VITE_API_URL=
# Split hosts only:
# VITE_API_URL=https://api.example.com

# Public browser Sentry DSN (restricted project; still not a secret — rate-limit in Sentry)
# PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# PUBLIC_SENTRY_ENVIRONMENT=production
# PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Server-side SvelteKit hooks (adapter-node) may also read:
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
