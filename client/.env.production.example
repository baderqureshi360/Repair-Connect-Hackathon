# =============================================================================
# RepairConnect frontend — PRODUCTION build-time / Vercel template
# Set on the CI/CD build or Vercel project. NEVER put JWT_SECRET / MONGODB_URI here.
# =============================================================================

# --- Recommended for dual Vercel projects (first-party cookies) ---
# Leave VITE_API_URL EMPTY so the browser calls same-origin /api/* .
# The SvelteKit route proxies to the Express project (see API_PROXY_TARGET).
# VITE_API_URL=

# Server-only (Vercel → Project → Environment Variables → Production).
# Not prefixed with VITE_/PUBLIC_ — must not appear in the browser bundle.
# API_PROXY_TARGET=https://repairconnect-server.vercel.app

# --- Legacy / emergency: direct cross-site API (third-party cookies) ---
# Only if the same-origin proxy cannot be used. Requires COOKIE_SAME_SITE=none
# + Secure + Partitioned on the API, and browsers that still allow the cookies.
# VITE_API_URL=https://repairconnect-server.vercel.app

# Public browser Sentry DSN (restricted project; still not a secret — rate-limit in Sentry)
# PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# PUBLIC_SENTRY_ENVIRONMENT=production
# PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Server-side SvelteKit hooks (adapter-node / Vercel) may also read:
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
