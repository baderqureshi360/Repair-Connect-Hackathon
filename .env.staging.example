# =============================================================================
# RepairConnect — STAGING template (isolated environment only)
# Copy into the staging host secret store. NEVER commit real values.
# Not for public production traffic.
# =============================================================================

NODE_ENV=production
PORT=5000

# Prefer a dedicated Atlas cluster or logical DB — not live customer data.
MONGODB_URI=mongodb+srv://USER:PASS@STAGING-CLUSTER/?retryWrites=true&w=majority
USE_MEMORY_DB=false

JWT_SECRET=replace-with-staging-openssl-rand-hex-32-or-longer
ACCESS_TOKEN_TTL_SEC=7200
REFRESH_TOKEN_TTL_SEC=604800

# Exact staging frontend origin (HTTPS)
CLIENT_URL=https://staging.example.com
# CLIENT_URL_ALT=

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Cross-site staging (Vercel preview + separate API):
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.example.com

SEED_ON_START=false
ALLOW_DEMO_LOGIN=false

# Optional staging provisioning key (≥16 chars when set)
# PROVISIONING_API_KEY=

# Sentry — use a staging project / environment tag
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.2

# Frontend build-time (client):
# VITE_API_URL=https://api-staging.example.com
# PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# PUBLIC_SENTRY_ENVIRONMENT=staging
