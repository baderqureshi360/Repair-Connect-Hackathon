# Monorepo root env — loaded by server regardless of cwd (npm -w server, tsx, dist).
# Copy to .env and fill values. Do not commit real secrets.

MONGODB_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Atlas mode (persistent):
#   MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
#   USE_MEMORY_DB=false
#
# Local memory mode (explicit only — never silent):
#   MONGODB_URI=
#   USE_MEMORY_DB=true
#
# Production forbids empty MONGODB_URI, USE_MEMORY_DB=true, SEED_ON_START=true,
# and ALLOW_DEMO_LOGIN=true. JWT_SECRET must be >= 32 characters in production.

USE_MEMORY_DB=false

# Optional: seed when API starts (forbidden in production)
# SEED_ON_START=false

# Demo seed account logins (*.@repairconnect.local). Default on in development; always off in production.
# ALLOW_DEMO_LOGIN=true

# Cookie session (HttpOnly JWT cookies + double-submit CSRF)
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
# ACCESS_TOKEN_TTL_SEC=7200
# REFRESH_TOKEN_TTL_SEC=604800
# Cross-site deployments need COOKIE_SAME_SITE=none (Secure is forced automatically).
# CLIENT_URL_ALT=

# Frontend (client/.env or root): leave empty to use Vite proxy (same-origin cookies in local dev)
# VITE_API_URL=
# Never put JWT_SECRET / MONGODB_URI / PROVISIONING_API_KEY in VITE_* (they would ship to browsers).

# --- Hosting ---
# API: persistent Node Express (VPS / Railway / Render / Fly). Never deploy Express as a Vercel serverless function.
# Web options:
#   A) Node VPS + nginx → default @sveltejs/adapter-node (see DEPLOYMENT.md)
#   B) Vercel frontend → set ADAPTER=vercel locally to test, or deploy with Root Directory=client
#      (Vercel sets VERCEL=1 automatically). Require build-time:
#        VITE_API_URL=https://<your-api-host>
#      And on the API host for cross-site Vercel origins:
#        CLIENT_URL=https://<your-vercel-app>
#        COOKIE_SAME_SITE=none
# See docs/VERCEL_DEPLOYMENT_PLAN.md. Do not deploy until domains and API host are confirmed.
# ADAPTER=node

# Shop-owner application provisioning (approve / reject / claim) + platform operator bootstrap.
# Generate a long random string. Never commit the real value.
# Also required as --confirm-key when running: npm run platform:create-operator -w server
# PROVISIONING_API_KEY=
