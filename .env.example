# Monorepo root env — loaded by server regardless of cwd (npm -w server, tsx, dist).
# Copy to .env and fill values. Do not commit real secrets.

MONGODB_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Atlas mode (persistent):
#   MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
#   USE_MEMORY_DB=false
#
# Local memory mode (explicit only — never silent):
#   MONGODB_URI=
#   USE_MEMORY_DB=true
#
# Production forbids empty MONGODB_URI, USE_MEMORY_DB=true, SEED_ON_START=true,
# and ALLOW_DEMO_LOGIN=true. JWT_SECRET must be >= 32 characters in production.

USE_MEMORY_DB=false

# Optional: seed when API starts (forbidden in production)
# SEED_ON_START=false

# Demo seed account logins (*.@repairconnect.local). Default on in development; always off in production.
# ALLOW_DEMO_LOGIN=true

# Cookie session (HttpOnly JWT cookies + double-submit CSRF)
# Refresh tokens are registered server-side (hashed only) with rotation + reuse detection.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
#   Production always forces Secure cookies. Set COOKIE_SECURE=true under HTTPS.
#   COOKIE_SECURE=false is fatal in production.
# COOKIE_DOMAIN=
# ACCESS_TOKEN_TTL_SEC=7200
# REFRESH_TOKEN_TTL_SEC=604800
# Cross-site deployments need COOKIE_SAME_SITE=none (Secure is forced automatically).
# CLIENT_URL_ALT=

# Error monitoring (Sentry) — never commit real DSNs
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Smoke (requires DSN): npm run monitor:smoke -w server

# Frontend (client/.env or root): leave empty to use Vite proxy (same-origin cookies in local dev)
# VITE_API_URL=
# Never put JWT_SECRET / MONGODB_URI / PROVISIONING_API_KEY in VITE_* (they would ship to browsers).

# --- Hosting ---
# API: persistent Node Express (VPS / Railway / Render / Fly / Enzonic). Never deploy Express as a Vercel serverless function.
# Web options:
#   A) Single process (Enzonic / VPS): build client with adapter-node + empty VITE_API_URL;
#      Express mounts client/build/handler.js (SERVE_WEB=true). See docs/ENZONIC_SINGLE_PROCESS.md
#   B) Split hosts → Vercel frontend: ADAPTER=vercel / VERCEL=1 + VITE_API_URL=https://<api-host>
#      API: CLIENT_URL=https://<frontend> and COOKIE_SAME_SITE=none
# See docs/VERCEL_DEPLOYMENT_PLAN.md / docs/RENDER_HACKATHON_DEPLOYMENT.md.
# ADAPTER=node
# Local `npm run dev` (Vite :5173 + Express :5000): set SERVE_WEB=false so Express stays API-only.
# Single-process / Enzonic production: SERVE_WEB=true after `npm run build -w client`.
# SERVE_WEB=false
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Shop-owner application provisioning (approve / reject / claim) + platform operator bootstrap.
# Generate a long random string. Never commit the real value.
# Also required as --confirm-key when running: npm run platform:create-operator -w server
# PROVISIONING_API_KEY=
